{
  "manifest_version": 3,
  "name": "AI Memory - Conversation Saver",
  "version": "1.0.0",
  "description": "Automatically saves your conversations from Claude, ChatGPT, Gemini, and Grok so you never lose a thought.",
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://claude.ai/*",
    "https://chat.openai.com/*",
    "https://chatgpt.com/*",
    "https://gemini.google.com/*",
    "https://x.com/*",
    "https://grok.com/*"
  ],
  "background": {
    "service_worker": "scripts/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": ["scripts/extractor-claude.js", "scripts/content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://chat.openai.com/*", "https://chatgpt.com/*"],
      "js": ["scripts/extractor-chatgpt.js", "scripts/content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://gemini.google.com/*"],
      "js": ["scripts/extractor-gemini.js", "scripts/content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://x.com/i/grok*", "https://grok.com/*"],
      "js": ["scripts/extractor-grok.js", "scripts/content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "pages/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["pages/viewer.html", "pages/viewer.js", "styles/viewer.css"],
      "matches": ["<all_urls>"]
    }
  ]
}
